{
  "name": "fuse-desktop",
  "productName": "Fuse",
  "version": "0.1.0",
  "description": "A desktop interface for running Claude Code and Codex on your local repositories.",
  "//": "Vite bundles app code; electron-updater remains an external runtime dependency.",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./out/main/index.js",
  "author": {
    "name": "Numina"
  },
  "repository": { "type": "git", "url": "https://github.com/project-numina/fuse-desktop.git" },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint .",
    "check:structure": "node scripts/code-health.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:inventory": "node scripts/test-inventory.mjs",
    "test:watch": "vitest",
    "package": "electron-vite build && electron-builder --dir --publish never",
    "dist": "electron-vite build && electron-builder --publish never",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux --publish never"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.276",
    "@base-ui/react": "^1.8.0",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/merge": "^6.12.1",
    "@codemirror/state": "^6.7.3",
    "@codemirror/view": "^6.43.11",
    "@eslint/js": "^10.0.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.15.0",
    "@types/prismjs": "^1.26.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "codemirror-lang-latex": "^0.6.1",
    "dompurify": "^3.4.14",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "elkjs": "^0.11.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "highlight.js": "^11.12.0",
    "highlightjs-lean": "^1.2.0",
    "hono": "^4.13.7",
    "jsdom": "^30.0.1",
    "katex": "^0.17.0",
    "lucide-react": "^1.41.0",
    "pdfjs-dist": "6.3.289",
    "prismjs": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.3.0",
    "vitest": "^4.1.11",
    "y-codemirror.next": "^0.3.6",
    "yjs": "^13.6.32",
    "zod": "^4.6.4"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
